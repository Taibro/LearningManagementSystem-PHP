# API Backend Configuration Example
# - Máy ảo Android Emulator: http://10.0.2.2:8000/api
# - Máy ảo iOS Simulator: http://localhost:8000/api
# - Thiết bị thật (Physical Device Expo Go): http://192.168.x.x:8000/api (IP máy tính cùng mạng WiFi)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_USE_MOCK_DATA=true
