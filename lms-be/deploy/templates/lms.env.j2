APP_NAME=LMS
APP_ENV=production
APP_KEY={{ app_key }}
APP_DEBUG=false
APP_URL=https://{{ api_domain }}

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=lms_db
DB_PORT=5432
DB_DATABASE=lms
DB_USERNAME=lms_user
DB_PASSWORD={{ db_password }}
DB_APP_USERNAME=lms_app_role
DB_APP_PASSWORD={{ db_app_password | default('lms_app_secret_password') }}

SESSION_DRIVER=file
SANCTUM_STATEFUL_DOMAINS={{ frontend_origin | replace('https://', '') }}
CORS_ALLOWED_ORIGINS={{ frontend_origin }}
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

KEYCLOAK_BASE_URL=https://{{ auth_domain }}
KEYCLOAK_REALM=lms
KEYCLOAK_CLIENT_ID=lms-web
KEYCLOAK_CLIENT_SECRET={{ kc_client_secret | default('') }}
KEYCLOAK_API_AUDIENCE=lms-api
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME={{ kc_admin_user | default('admin') }}
KEYCLOAK_ADMIN_PASSWORD={{ kc_admin_password | default('') }}
KEYCLOAK_REDIRECT_URI={{ frontend_origin }}/auth/callback

L5_SWAGGER_USE_ABSOLUTE_PATH=false
L5_SWAGGER_GENERATE_ALWAYS=false

FILESYSTEM_DISK={{ 'r2' if (r2_bucket | default('') | length > 0) else 'local' }}
R2_ACCESS_KEY_ID={{ r2_access_key_id | default('') }}
R2_SECRET_ACCESS_KEY={{ r2_secret_access_key | default('') }}
R2_REGION=auto
R2_BUCKET={{ r2_bucket | default('') }}
R2_ENDPOINT={{ r2_endpoint | default('') }}
R2_PUBLIC_URL={{ r2_public_url | default('') }}
R2_USE_PATH_STYLE_ENDPOINT=true
R2_PRESIGNED_UPLOAD_TTL_MINUTES=10
R2_PRESIGNED_DOWNLOAD_TTL_MINUTES=15
R2_MAX_UPLOAD_SIZE_MB=20
