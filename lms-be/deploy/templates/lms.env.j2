APP_NAME=LMS
APP_ENV=production
APP_KEY={{ app_key }}
APP_DEBUG=false
APP_URL=https://{{ api_domain }}

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=lms_db
DB_PORT=5432
DB_DATABASE=lms
DB_USERNAME=lms_user
DB_PASSWORD={{ db_password }}
DB_APP_USERNAME=lms_app_role
DB_APP_PASSWORD={{ db_app_password | default('lms_app_secret_password') }}

SESSION_DRIVER=file
SANCTUM_STATEFUL_DOMAINS={{ frontend_origin | replace('https://', '') }}
CORS_ALLOWED_ORIGINS={{ frontend_origin }}

KEYCLOAK_BASE_URL=https://{{ auth_domain }}
KEYCLOAK_REALM=lms
KEYCLOAK_CLIENT_ID=lms-web
KEYCLOAK_CLIENT_SECRET={{ kc_client_secret | default('') }}
KEYCLOAK_API_AUDIENCE=lms-api
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME={{ kc_admin_user | default('admin') }}
KEYCLOAK_ADMIN_PASSWORD={{ kc_admin_password | default('') }}
KEYCLOAK_REDIRECT_URI={{ frontend_origin }}/auth/callback

L5_SWAGGER_USE_ABSOLUTE_PATH=false
L5_SWAGGER_GENERATE_ALWAYS=false
